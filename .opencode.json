{
  "$schema": "./opencode-schema.json",
  "default_agent": "coder",
  "model": "anthropic/claude-4-sonnet",
  "small_model": "anthropic/claude-3.5-haiku",
  "agents": {
    "security-auditor": {
      "description": "Auditoria de segurança do código",
      "mode": "subagent",
      "system": "Você é um auditor de segurança. Revise o código buscando vulnerabilidades.",
      "permissions": [
        { "action": "shell", "effect": "deny" },
        { "action": "edit", "effect": "ask" }
      ]
    }
  },
  "lsp": {
    "gopls": {
      "command": "gopls"
    }
  },
  "instructions": ["AGENTS.md"],
  "tool_output": { "max_lines": 2000, "max_bytes": 51200 }
}
